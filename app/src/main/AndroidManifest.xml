<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Inicio automático: para que la app pueda abrirse sola al conectar la
        carga (sin una rutina externa) necesita dibujarse sobre otras apps.
        El usuario lo concede manualmente en Ajustes; no se pide en silencio.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name=".RelojApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RelojNoche">

        <!--
            Reloj a pantalla completa: es lo que abre el icono de la app.
            fullSensor: gira con el telefono aunque el bloqueo de rotacion
            este activo (util en un soporte de carga horizontal).
        -->
        <activity
            android:name=".ClockActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="fullSensor"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.RelojNoche.Clock">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Ajustes. exported=true porque Ajustes > Protector de pantalla
            (otra app) la abre desde el engranaje junto a "Reloj de Noche".
        -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title"
            android:theme="@style/Theme.RelojNoche" />

        <!--
            Protector de pantalla (DreamService). Android lo muestra solo
            cuando el telefono esta cargando y la pantalla se iba a apagar.
        -->
        <service
            android:name=".ClockDreamService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.service.dream"
                android:resource="@xml/dream_info" />
        </service>

        <!--
            Inicio automático: escucha la conexión a la carga. ACTION_POWER_
            CONNECTED es uno de los pocos broadcasts implícitos que se pueden
            declarar en el manifiesto en Android moderno. El receiver solo actúa
            si el usuario activó el inicio automático y concedió el permiso de
            superposición.
        -->
        <receiver
            android:name=".PowerConnectionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
